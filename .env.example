# =============================================================================
# InventoryOS — Environment Variables
# =============================================================================
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# The .env file is gitignored — never commit real secrets.
# All variables below are read by the app at runtime via process.env.
#
# After editing .env, restart the dev server:
#   bun run dev
#
# =============================================================================


# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# Local dev (with docker-compose): points at the postgres service below.
# Production: points at your hosted PostgreSQL instance.
DATABASE_URL="postgresql://inventoryos:inventoryos_dev_password@localhost:5432/inventoryos?schema=public"

# Direct connection for Prisma migrations (bypasses PgBouncer if you use one).
# For local dev, this can be the same as DATABASE_URL.
# For production with PgBouncer, set this to a direct connection (not pooled).
DIRECT_DATABASE_URL="postgresql://inventoryos:inventoryos_dev_password@localhost:5432/inventoryos?schema=public"


# ─── Redis (OPTIONAL for dev) ────────────────────────────────────────────────
# Redis connection URL. If not set, the app falls back to in-memory cache
# (works fine for local dev; production should use Redis for multi-instance).
#
# Local dev (with docker-compose): points at the redis service below.
REDIS_URL="redis://localhost:6379"


# ─── App URL (REQUIRED for email links) ──────────────────────────────────────
# Public URL where the app is reachable. Used in email links, cron-job
# notifications, and SSL Commerz redirect URLs.
#
# Local dev: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ─── Cron Jobs (REQUIRED in production) ──────────────────────────────────────
# Secret string that must be sent as the x-cron-secret header to all
# /api/cron/* endpoints. Without this, cron jobs (subscription lifecycle,
# report scheduling, nightly stats) will not run.
#
# Generate a strong random string:
#   openssl rand -hex 32
CRON_SECRET="dev-cron-secret-change-in-production"


# ─── Super-Admin Seed (REQUIRED for first run) ───────────────────────────────
# Used by `prisma db seed` to create the default super-admin account.
# Only creates the account on first run — never overwrites an existing password.
# Change these before seeding production.
SUPER_ADMIN_USERNAME="superadmin"
SUPER_ADMIN_DEFAULT_PASSWORD="admin123"


# ─── SMTP Email (OPTIONAL — can also configure via Admin → API Setup) ────────
# If set, the app uses these for sending email. If not set, the app falls back
# to SMTP config stored in the database (configurable via the admin UI).
# Leave commented out for local dev — emails will be logged to console.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="InventoryOS <your-email@gmail.com>"


# ─── AI Providers (OPTIONAL — enables AI features) ───────────────────────────
# Z.AI SDK (recommended — works out of the box on Z.ai preview)
# Get a key from: https://z.ai
# ZAI_API_KEY="your-zai-api-key"
# ZAI_API_BASE="https://api.z.ai/v1"

# Other AI providers (OpenAI, Anthropic, Google) can be configured via
# Admin → API Setup → AI Providers tab in the running app.


# ─── SSL Commerz Payments (OPTIONAL — enables online subscription payments) ──
# Get credentials from: https://sslcommerz.com
# SSL_STORE_ID="your-store-id"
# SSL_STORE_PASSWD="your-store-password"
# SSL_MODE="sandbox"  # "sandbox" for testing, "production" for live


# ─── Sentry Error Tracking (OPTIONAL — recommended for production) ───────────
# Get a DSN from: https://sentry.io
# SENTRY_DSN="https://your-key@sentry.io/project-id"
# NEXT_PUBLIC_SENTRY_DSN="https://your-key@sentry.io/project-id"
# SENTRY_ENVIRONMENT="development"


# ─── Misc (OPTIONAL) ─────────────────────────────────────────────────────────
# Founder email — receives kill-switch alerts (or use Notification Recipients in admin)
# FOUNDER_EMAIL="founder@your-domain.com"

# Enable /api/health/test-error endpoint for testing Sentry integration.
# MUST be "false" (or unset) in production.
TEST_ERROR_ENABLED="false"
