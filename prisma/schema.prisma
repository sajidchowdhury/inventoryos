// ── Cron Job Log ──
model CronJobLog {
  id            String   @id @default(cuid())
  jobName       String
  status        String   // "running" | "success" | "failed"
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  businessesProcessed Int @default(0)
  recordsWritten     Int @default(0)
  errorMessage       String?
  log           String?

  @@index([jobName, startedAt])
  @@index([status])
  @@index([startedAt])
}

// ── AI Response Cache (Gap 9) ──
model AIResponseCache {
  id              String   @id @default(cuid())
  businessId      String
  feature         String
  normalizedQuery String
  dataHash        String
  response        String
  tokensUsed      Int      @default(0)
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, feature, normalizedQuery, dataHash])
  @@index([businessId, feature, normalizedQuery])
  @@index([expiresAt])
  @@index([businessId, expiresAt])
}

// ── FEFO Override Audit Trail (Gap 11) ──
// Records every time staff overrides FEFO (picks a later-expiring batch
// instead of the soonest-expiring one). Required for DGDA compliance.
model FefoOverride {
  id              String   @id @default(cuid())
  businessId      String
  saleId          String?
  saleItemId      String?
  productId       String
  productName     String   // snapshot
  selectedBatchId String   // the batch actually dispensed
  selectedBatchNo String   // snapshot
  expectedBatchId String   // the FEFO-first batch that was skipped
  expectedBatchNo String   // snapshot
  userId          String?  // who made the override
  userName        String?  // snapshot
  reason          String   // required, min 10 chars
  createdAt       DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([saleId])
  @@index([productId])
}

// ── AI Configuration (Phase 1: configurable cost-control knobs) ──
// Stores per-feature AI limits that the founder can tune from the super-admin
// panel without redeploying. Falls back to hardcoded defaults in src/lib/ai-config.ts
// if the row is missing or the DB is unreachable.
//
// Features:
//   - "chat"             → maxOutputTokens (default 1024)
//   - "insights"         → maxOutputTokens (default 2048)
//   - "expiry-optimizer" → maxOutputTokens (default 2048) + maxInputBatches (default 50)
//   - "product-assistant"→ maxOutputTokens (default 512)  + maxInputProducts (default 20)
model AiConfig {
  id               String   @id @default(cuid())
  feature          String   @unique
  maxOutputTokens  Int      @default(1024)
  maxInputBatches  Int?     // only used by expiry-optimizer
  maxInputProducts Int?     // only used by product-assistant:check_interactions
  maxInputImages   Int?     // only used by shelf-scanner (max photos per scan)
  systemPrompt     String?  // shelf-scanner: custom system prompt (null = default)
  userPromptTemplate String? // shelf-scanner: user prompt with {{imageCount}} placeholder
  temperature      Float?   // shelf-scanner: LLM temperature (null = 0.1)
  disableThinking  Boolean? // shelf-scanner: disable Gemini 2.5+ internal reasoning (null = true)
  updatedAt        DateTime @updatedAt
  updatedBy        String?  // super-admin username

  @@map("ai_configs")
}

// ── Kill Switch Audit Log (Phase 4) ──
// Records every time a kill-switch trigger fires. Each row = one trigger event.
// isActive=true means the kill-switch is currently blocking AI for that scope
// (per-pharmacy for triggers 1+2, platform-wide for triggers 3+4).
// Super-admin resets by setting isActive=false via /api/super-admin/kill-switch/[id]/reset.
model KillSwitch {
  id             String   @id @default(cuid())
  trigger        String   // "per_pharmacy_monthly" | "per_pharmacy_24h" | "platform_monthly" | "zai_error_rate"
  thresholdValue Float    @default(0) // the threshold that was configured at trigger time
  actualValue    Float    @default(0) // the actual value that triggered it
  triggeredAt    DateTime @default(now())
  triggeredBy    String   // businessId for triggers 1+2, "platform" for triggers 3+4
  isActive       Boolean  @default(true)
  deactivatedAt  DateTime?
  deactivatedBy  String?  // super-admin username
  notes          String?

  @@index([trigger, isActive])
  @@index([triggeredAt])
  @@index([triggeredBy])
  @@map("kill_switches")
}

// ── Kill Switch Thresholds (Phase 4: dynamic, editable from super admin) ──
// The founder can tune these from /admin without redeploying. Each trigger has
// its own row with a configurable threshold value.
//
// Triggers:
//   "per_pharmacy_monthly"  → max BDT per pharmacy per month (default 200)
//   "per_pharmacy_24h"      → max tokens per pharmacy per 24h (default 50000)
//   "platform_monthly"      → max BDT platform-wide per month (default 100000)
//   "zai_error_rate"        → max error rate % in 1 hour (default 10)
model KillSwitchThreshold {
  id            String   @id @default(cuid())
  trigger       String   @unique
  thresholdValue Float   @default(0)
  unit          String   @default("") // "BDT", "tokens", "BDT", "%" for display
  isActive      Boolean  @default(true) // founder can disable a trigger entirely
  updatedAt     DateTime @updatedAt
  updatedBy     String?

  @@map("kill_switch_thresholds")
}

// ── Notification Recipients (Phase 4: up to 3 emails for kill-switch alerts) ──
// The founder can configure up to 3 email addresses from /admin. When a
// kill-switch triggers, an email is sent to ALL active recipients.
// If no recipients are configured, the alert is logged to NotificationLog only.
model NotificationRecipient {
  id        String   @id @default(cuid())
  email     String   @unique
  label     String?  // e.g., "Founder", "CTO", "On-call engineer"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_recipients")
}

// ═══════════════════════════════════════════════════════════════════════════
// ── AI REPORT SCHEDULING SYSTEM (Phase A) ──
// 7 models for the weekly client-hook feature:
//   1. ReportSchedule   — founder's schedule config (weekly/monthly/date_range)
//   2. ReportOccasion   — point events (Eid, Friday, Puja)
//   3. ReportSeason     — recurring seasonal periods (Winter, Monsoon, Summer)
//   4. HolidayCalendar  — specific occasion dates per year (Eid 2026 = 2026-04-10)
//   5. EpidemicAlert    — active outbreaks (dengue, COVID) that override predictions
//   6. GeneratedReport  — the report itself (one per business per schedule run)
//   7. ReportDelivery   — delivery tracking (email + WhatsApp)
// ═══════════════════════════════════════════════════════════════════════════

// ── 1. ReportSchedule ──
// Founder's schedule configuration. Each row defines one recurring schedule
// (e.g., "Weekly Monday report for all Pro+AI clients considering Eid + Winter").
// Platform-wide — generates reports for multiple businesses.
model ReportSchedule {
  id                String    @id @default(cuid())
  name              String    // e.g., "Weekly Eid-Aware Report"
  description       String?
  frequency         String    // "weekly" | "monthly" | "date_range"
  dayOfWeek         Int?      // For weekly: 0=Sun, 1=Mon, ..., 6=Sat
  dayOfMonth        Int?      // For monthly: 1-28 (avoids 29/30/31 to prevent skipped months)
  startDate         DateTime? // For date_range: first report date
  endDate           DateTime? // For date_range: last report date
  occasions         String    @default("[]") // JSON array of occasion IDs to consider (empty = all active)
  considerSeasons   Boolean   @default(true) // Whether to apply seasonal adjustments
  considerEpidemics Boolean   @default(true) // Whether to apply active epidemic alerts
  targetClientMode  String    @default("all") // "all" | "selected"
  targetClientIds   String?   // JSON array of businessIds. Null if "all"
  deliveryChannels  String    @default("[\"email\"]") // JSON: ["email"] | ["whatsapp"] | ["email","whatsapp"]
  reportPeriodDays  Int       @default(7) // How many days ahead to predict (7=weekly, 14=biweekly)
  // Phase 6: multi-project filtering. Null = all projects (backward compatible).
  // When set, the schedule checker only targets businesses of this type.
  businessTypeId    String?
  isActive          Boolean   @default(true)
  lastRunAt         DateTime?
  nextRunAt         DateTime?
  createdBy         String?   // super-admin username
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  generatedReports GeneratedReport[]

  @@index([isActive, nextRunAt])
  @@index([frequency])
  @@index([businessTypeId])
  @@map("report_schedules")
}

// ── 2. ReportOccasion ──
// Point-in-time events (Eid, Friday, Puja, government holidays).
// Duration is short (1-7 days). Recurrence is predictable (annual/weekly).
// Pre-seeded with 14+ Bangladesh occasions.
model ReportOccasion {
  id              String   @id @default(cuid())
  name            String   // "Eid-ul-Fitr", "Friday", etc.
  slug            String   @unique // "eid-ul-fitr", "friday"
  type            String   // "religious" | "national" | "weekly" | "custom"
  datePattern     String   // "fixed_date" | "lunar_approximate" | "recurring_weekly"
  fixedMonth      Int?     // For fixed_date: 1-12
  fixedDay        Int?     // For fixed_date: 1-31
  weeklyDayOfWeek Int?     // For recurring_weekly: 0=Sun, 5=Fri, 6=Sat
  impactWeight    Float    @default(1.0) // 1.0=normal, 2.5=150% boost, 0.3=70% reduction
  durationDays    Int      @default(1) // How long the spike lasts (Eid=7, Friday=1)
  leadDays        Int      @default(0) // Days BEFORE occasion the spike starts (Eid shopping=5 days before)
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  holidayCalendar HolidayCalendar[]

  @@map("report_occasions")
}

// ── 3. ReportSeason ──
// Recurring seasonal periods that shift baseline demand for months at a time.
// Unlike occasions (point events), seasons are extended periods (2-3 months)
// with a "multiplier" that adjusts the baseline demand for affected product
// categories throughout the season.
//
// Pre-seeded with 4 Bangladesh seasons:
//   - Winter (Dec-Feb): respiratory meds spike 1.5x
//   - Summer (Mar-May): ORS, antacids, heatstroke meds 1.3x (overlaps Ramadan/Eid)
//   - Monsoon (Jun-Sep): dengue/malaria/water-borne disease meds 2.0x
//   - Autumn (Oct-Nov): transition, baseline 1.0x
//
// A season's effect is COMPOUND with occasions: Eid in Monsoon = Eid spike (2.8x)
// applied to the Monsoon-adjusted baseline (2.0x) = 5.6x for dengue meds during
// Eid in monsoon. The prediction algorithm handles this layering.
model ReportSeason {
  id              String   @id @default(cuid())
  name            String   // "Winter", "Summer", "Monsoon", "Autumn"
  slug            String   @unique // "winter", "monsoon"
  startMonth      Int      // 1-12 (e.g., Winter = 12)
  startDay        Int      @default(1) // 1-31
  endMonth        Int      // 1-12 (e.g., Winter = 2)
  endDay          Int      @default(28) // 1-31
  impactWeight    Float    @default(1.0) // 1.0=normal, 1.5=50% boost, 0.8=20% reduction
  affectedCategories String @default("[]") // JSON array of category names most affected
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("report_seasons")
}

// ── 4. HolidayCalendar ──
// Stores the specific dates of occasions for each year.
// Necessary because lunar occasions (Eid) shift each year and must be confirmed.
// The prediction algorithm queries this to know which dates in the next 7-14
// days have occasions, then looks up the same occasions in historical sales.
model HolidayCalendar {
  id          String   @id @default(cuid())
  occasionId  String
  date        DateTime // Specific date of this occurrence (e.g., 2026-06-17 for Eid-ul-Adha 2026)
  isConfirmed Boolean  @default(false) // Lunar dates are estimates until founder confirms
  year        Int      // Derived from date — used for yearly filtering
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  occasion ReportOccasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@unique([occasionId, date])
  @@index([date])
  @@index([year])
  @@map("holiday_calendar")
}

// ── 5. EpidemicAlert ──
// Active disease outbreaks that override normal prediction patterns.
// Unlike occasions and seasons (which are predictable), epidemics are
// unpredictable events declared by the founder when an outbreak is detected
// (e.g., "Dengue outbreak in Dhaka — severity high — antimalarials + IV fluids
// spike 4x"). The alert has a start/end date and is "active" during that window.
// The prediction algorithm applies the epidemic multiplier ON TOP of seasonal
// and occasion adjustments, because during an outbreak, demand for affected
// products spikes regardless of season.
//
// Pre-seeded with 2 example alerts (inactive by default):
//   - Dengue outbreak (annual, founder activates when detected)
//   - COVID-19 (historical, inactive)
model EpidemicAlert {
  id                String    @id @default(cuid())
  name              String    // "Dengue Outbreak 2026", "COVID-19 Wave"
  slug              String    @unique
  diseaseType       String    // "dengue" | "covid" | "cholera" | "nipah" | "flu" | "custom"
  severity          String    @default("moderate") // "mild" | "moderate" | "severe" | "critical"
  impactWeight      Float     @default(2.0) // Multiplier for affected products (2.0 = 100% boost)
  affectedCategories String   @default("[]") // JSON array of category names most affected
  affectedProducts  String    @default("[]") // JSON array of specific product names (optional)
  startDate         DateTime
  endDate           DateTime  // When the alert is expected to end (founder extends if needed)
  isActive          Boolean   @default(true) // Founder can deactivate without deleting
  declaredBy        String?   // super-admin username
  notes             String?   // e.g., "Dhaka city reports 500+ cases per week"
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([isActive, startDate, endDate])
  @@index([diseaseType])
  @@map("epidemic_alerts")
}

// ── 6. GeneratedReport ──
// One row per business per schedule run. Contains the full report content as
// JSON fields, plus cost tracking and status. This is the table the report
// viewer UI queries.
model GeneratedReport {
  id                   String    @id @default(cuid())
  scheduleId           String
  businessId           String
  reportDate           DateTime  // When the report was generated
  reportPeriodStart    DateTime  // First day of prediction period (e.g., next Monday)
  reportPeriodEnd      DateTime  // Last day of prediction period (e.g., next Sunday)
  executiveSummary     String?   // 2-3 sentence AI-generated summary
  spikePredictions     String?   // JSON array of top 3 spike predictions
  topItems             String?   // JSON array of 20 items with predictedQty, profit, supplier, stock status
  stockRisks           String?   // JSON array of stock risk items with purchase recommendations
  appliedInfluences    String    @default("{}") // JSON: which occasions/seasons/epidemics were considered
  aiTokensUsed         Int       @default(0)
  aiCostEstimate       Float     @default(0.0)
  generationStatus     String    @default("pending") // "pending" | "generating" | "completed" | "failed"
  errorMessage         String?
  pdfUrl               String?
  predictionConfidence String    @default("medium") // "low" | "medium" | "high"
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  schedule ReportSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deliveries ReportDelivery[]

  @@index([scheduleId, reportDate])
  @@index([businessId, reportDate])
  @@index([generationStatus])
  @@index([reportDate])
  @@map("generated_reports")
}

// ── 7. ReportDelivery ──
// Tracks delivery of each report via each channel. One GeneratedReport can
// have multiple ReportDelivery rows (one per channel). This is the table the
// delivery status UI queries.
model ReportDelivery {
  id                String    @id @default(cuid())
  reportId          String
  channel           String    // "email" | "whatsapp"
  recipient         String    // email address or phone number
  status            String    @default("queued") // "queued" | "sent" | "delivered" | "read" | "failed"
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  errorMessage      String?
  retryCount        Int       @default(0)
  providerMessageId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  report GeneratedReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([status])
  @@index([channel, status])
  @@map("report_deliveries")
}

// ── P1: Subscription Billing Models ──
// Per-shop billing: each Business has its own invoices + payment transactions.
// The admin (BusinessUser.isAdmin=true) handles the subscription per shop.

// One per billing period per business (monthly or annual).
// Generated by a monthly cron or on-demand from the super-admin panel (P3/P4).
model SubscriptionInvoice {
  id            String   @id @default(cuid())
  businessId    String
  tier          String   // "free" / "pro" / "pro_ai"
  billingPeriod String   // "month" / "year"
  amount        Float    // BDT
  status        String   @default("pending") // "pending" / "paid" / "overdue" / "cancelled"
  dueDate       DateTime
  paidAt        DateTime?
  paymentMethod String?  // "bkash" / "nagad" / "ssl_commerz" / "manual" (set when paid)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payments PaymentTransaction[]

  @@index([businessId])
  @@index([status])
  @@index([dueDate])
  @@map("subscription_invoices")
}

// One per payment attempt by a user.
// User submits bKash/Nagad TRX ID + amount → creates pending transaction.
// Auto-matching engine (P3) updates status from pending to matched when
// a ReceivedPayment with the same TRX ID + amount is uploaded by the super-admin.
model PaymentTransaction {
  id            String   @id @default(cuid())
  businessId    String
  invoiceId     String?
  method        String   // "bkash" / "nagad" / "ssl_commerz" / "manual"
  trxId         String   // bKash/Nagad transaction ID (10 chars) or SSL Commerz tranId
  amount        Float    // BDT
  status        String   @default("pending") // "pending" / "matched" / "rejected" / "refunded"
  submittedBy   String?  // user phone who submitted
  submittedAt   DateTime @default(now())
  matchedAt     DateTime?
  matchedBy     String?  // super-admin id who matched (or "auto" for auto-match)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice  SubscriptionInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([status])
  @@index([trxId])
  @@index([method])
  @@map("payment_transactions")
}

// Super-admin's record of money received in bKash/Nagad.
// The super-admin uploads these via the panel (P3). The auto-matching engine
// searches for a pending PaymentTransaction with the same TRX ID + amount (±5 BDT).
model ReceivedPayment {
  id                    String   @id @default(cuid())
  method                String   // "bkash" / "nagad"
  trxId                 String   // transaction ID from bKash/Nagad statement
  amount                Float    // BDT
  receivedAt            DateTime @default(now())
  uploadedBy            String?  // super-admin id
  matchedTransactionId  String?  // set when a user submission matches
  createdAt             DateTime @default(now())

  @@index([trxId])
  @@index([method])
  @@index([matchedTransactionId])
  @@map("received_payments")
}

// ── P5: Payment Configuration (singleton) ──
// Stores SSL Commerz credentials + active payment method toggles + bKash/Nagad
// account numbers. Editable from /admin/packages. Falls back to env vars if no row.
model PaymentConfig {
  id              String   @id @default("default")
  // SSL Commerz
  sslStoreId      String?
  sslStorePasswd  String?
  sslMode         String   @default("sandbox") // "sandbox" | "production"
  // Payment method toggles
  bkashActive     Boolean  @default(true)
  nagadActive     Boolean  @default(true)
  sslActive       Boolean  @default(false)
  // Account numbers shown to users on the Pay Subscription page
  bkashNumber     String?
  nagadNumber     String?
  // Tier prices (editable from admin, falls back to feature-gate.ts defaults)
  proMonthly      Float    @default(800)
  proAnnual       Float    @default(8000)
  proAiMonthly    Float    @default(1500)
  proAiAnnual     Float    @default(15000)
  updatedAt       DateTime @updatedAt
  updatedBy       String?

  @@map("payment_config")
}

// ── P6: Subscription Adjustment Audit Trail ──
// Logs every manual change to a business's subscription: refunds, extensions,
// reductions, plan changes. Required reason field for audit compliance.
model SubscriptionAdjustment {
  id            String   @id @default(cuid())
  businessId    String
  type          String   // "refund" | "extension" | "reduction" | "plan_change"
  daysAdjusted  Int      // positive = extension, negative = reduction
  amount        Float    @default(0) // BDT (for refunds)
  reason        String   // required — why the adjustment was made
  oldTier       String?
  newTier       String?
  createdBy     String?  // super-admin id
  createdAt     DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("subscription_adjustments")
}

// ── SMTP Configuration (Phase 6: dynamic, editable from super admin panel) ──
// Stores SMTP credentials in the DB so the founder can configure email delivery
// from /admin/api-setup → SMTP tab without touching environment variables.
// Only one row exists (singleton pattern: id = "default").
// Password is stored as-is (the DB itself should be access-controlled).
// Falls back to environment variables (SMTP_HOST etc.) if no row exists.
model SmtpConfig {
  id        String   @id @default("default")
  host      String
  port      Int      @default(587)
  user      String
  password  String
  fromEmail String?
  fromName  String   @default("InventoryOS")
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("smtp_configs")
}

// ═══════════════════════════════════════════════════════════════════════════
// ── MASTER PRODUCT CATALOG (Phase 1) ──
// Shared platform-level product catalog. 14,000+ products sourced from
// MedEx/Kaggle dataset. Pharmacies "subscribe" to products instead of
// entering them manually.
// ═══════════════════════════════════════════════════════════════════════════

// ── MasterManufacturer ──
// Pharmaceutical companies (Square, Beximco, Incepta, etc.)
model MasterManufacturer {
  id           String   @id @default(cuid())
  name         String   @unique
  shortCode    String?
  country      String   @default("Bangladesh")
  isActive     Boolean  @default(true)
  productCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products MasterProduct[]

  @@map("master_manufacturers")
}

// ── MasterProduct ──
// The shared product catalog. ~14,000 products from 232 manufacturers.
// No businessId — this is platform-level reference data.
// Pharmacies subscribe to these via Product.masterProductId.
model MasterProduct {
  id              String   @id @default(cuid())
  name            String   // Brand name (e.g., "Napa Extra")
  genericName     String?  // Generic name (e.g., "Paracetamol + Caffeine")
  strength        String?  // e.g., "500mg"
  dosageForm      String?  // Tablet, Capsule, Syrup, Injection, etc.
  manufacturerId  String?
  manufacturerStr String?  // Denormalized manufacturer name (for quick search)
  categoryName    String?  // e.g., "Pain & Fever"
  scheduleType    String?  // OTC, Schedule_H, Schedule_H1, Schedule_X, Narcotic
  hsnCode         String?
  vatRate         Float    @default(0)
  defaultMrp      Float?   // Default MRP in BDT
  dgdaRegNo       String?  @unique
  barcode         String?
  unit            String   @default("piece") // piece, tablet, ml, g
  stripSize       Int?
  boxSize         Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  manufacturer MasterManufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  shelfScanItems ShelfScanItem[]

  @@index([name])
  @@index([genericName])
  @@index([manufacturerStr])
  @@index([categoryName])
  @@index([dosageForm])
  @@index([barcode])
  @@index([isActive])
  @@map("master_products")
}

// ── Shelf Scanner (AI vision stock counting) ──
// A ShelfScan is created when a user uploads 2–3 shelf photos. The vision model
// detects medicines; each detection becomes a ShelfScanItem linked to a client
// Product (if matched) and/or a MasterProduct (catalog match). Stock updates
// from a scan are applied via POST /api/businesses/[id]/stock/bulk-update which
// writes Inventory.quantity + an ADJUSTMENT Transaction — never MasterProduct.
model ShelfScan {
  id            String   @id @default(cuid())
  businessId    String
  imageCount    Int
  detectedCount Int      @default(0)
  matchedCount  Int      @default(0)
  rawResult     String?  // full LLM JSON output, for debugging/replay
  tokensUsed    Int      @default(0)
  createdBy     String?  // BusinessUser ID who initiated the scan
  stockCountZoneSessionId String? // linked Stock Count Day zone session
  createdAt     DateTime @default(now())

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  zoneSession StockCountZoneSession? @relation(fields: [stockCountZoneSessionId], references: [id], onDelete: SetNull)
  items    ShelfScanItem[]

  @@index([businessId])
  @@index([stockCountZoneSessionId])
  @@index([createdAt])
  @@map("shelf_scans")
}

model ShelfScanItem {
  id                   String   @id @default(cuid())
  shelfScanId          String
  productId            String?  // matched client Product (null until linked/quick-added)
  masterProductId      String?  // matched MasterProduct (null if no catalog match)
  detectedName         String
  detectedStrength     String?
  detectedForm         String?
  detectedManufacturer String?
  confidence           Float    @default(0)    // 0.0–1.0 from the vision model
  matchedMethod        String   @default("ai") // "ai" | "master-catalog" | "manual" | "quick-add" | "unmatched"
  previousQuantity     Float    @default(0)    // Inventory.quantity at match time
  newQuantity          Float?                  // entered by user; null = skipped
  appliedAt            DateTime?               // stamped when bulk-update writes the Transaction
  createdAt            DateTime @default(now())

  shelfScan      ShelfScan      @relation(fields: [shelfScanId], references: [id], onDelete: Cascade)
  product        Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  masterProduct  MasterProduct? @relation(fields: [masterProductId], references: [id], onDelete: SetNull)

  @@index([shelfScanId])
  @@index([productId])
  @@index([masterProductId])
  @@map("shelf_scan_items")
}

// ══════════════════════════════════════════════════════════════════════════════
// Stock Counting Day (SCD) — monthly full-stock count while shop stays open
// ══════════════════════════════════════════════════════════════════════════════

// Permanent shop areas (reused every month). A product may belong to 2+ zones.
model StorageZone {
  id         String   @id @default(cuid())
  businessId String
  name       String
  sortOrder  Int      @default(0)
  color      String   @default("#0d9488")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignments ProductZoneAssignment[]
  zoneSessions StockCountZoneSession[]
  countLines  StockCountLine[]
  assignmentSnapshots ZoneAssignmentSnapshot[]  // P3: enables zone inheritance

  @@unique([businessId, name])
  @@index([businessId])
  @@map("storage_zones")
}

model ProductZoneAssignment {
  id         String   @id @default(cuid())
  businessId String
  productId  String
  zoneId     String
  createdAt  DateTime @default(now())

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  zone     StorageZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([productId, zoneId])
  @@index([businessId])
  @@index([zoneId])
  @@map("product_zone_assignments")
}

// One monthly (or ad-hoc) full count session per business.
model StockCountDay {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  status      String    @default("draft") // draft | active | closed | applied
  startedAt   DateTime?
  closedAt    DateTime?
  appliedAt   DateTime?
  startedBy   String?
  closedBy    String?
  appliedBy   String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  zoneSessions StockCountZoneSession[]
  lines        StockCountLine[]
  summaries    StockCountProductSummary[]
  sales        Sale[]
  // P3: snapshot of zone assignments at creation time (enables inheritance)
  assignmentSnapshots ZoneAssignmentSnapshot[]

  @@index([businessId])
  @@index([status])
  @@map("stock_count_days")
}

// Progress of each storage zone within a Stock Count Day.
model StockCountZoneSession {
  id         String    @id @default(cuid())
  scdId      String
  zoneId     String
  businessId String
  status     String    @default("pending") // pending | counting | review | closed
  closedAt   DateTime?
  closedBy   String?
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  scd        StockCountDay @relation(fields: [scdId], references: [id], onDelete: Cascade)
  zone       StorageZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  lines      StockCountLine[]
  shelfScans ShelfScan[]

  @@unique([scdId, zoneId])
  @@index([businessId])
  @@index([scdId])
  @@map("stock_count_zone_sessions")
}

// Per-product rollup for the whole SCD (sales + total counted across zones).
model StockCountProductSummary {
  id               String   @id @default(cuid())
  scdId            String
  businessId       String
  productId        String
  systemQtyAtStart Float    @default(0)
  soldDuringScd    Float    @default(0)
  totalCountedQty  Float?   // sum of zone lines once counted
  variance         Float?
  // P2: variance reason capture for audit trail
  varianceReason   String?  // theft | damage | data_error | expired | other
  varianceNote     String?  // optional free-text up to 500 chars
  updatedAt        DateTime @updatedAt

  scd     StockCountDay @relation(fields: [scdId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([scdId, productId])
  @@index([businessId])
  @@map("stock_count_product_summaries")
}

// Count line per product per zone (same product → separate lines in 2 zones).
model StockCountLine {
  id                String    @id @default(cuid())
  scdId             String
  zoneSessionId     String
  zoneId            String
  businessId        String
  productId         String
  countedQty        Float?
  systemQtyAtStart  Float     @default(0)
  soldDuringScd     Float     @default(0)
  status            String    @default("pending") // pending | counted | skipped
  detectedName      String?
  confidence        Float?
  shelfScanItemId   String?
  countedBy         String?
  countedAt         DateTime?
  notes             String?
  // P3: true if assignment was auto-created by scan-to-assign
  autoAssigned      Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  scd         StockCountDay         @relation(fields: [scdId], references: [id], onDelete: Cascade)
  zoneSession StockCountZoneSession @relation(fields: [zoneSessionId], references: [id], onDelete: Cascade)
  zone        StorageZone           @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  product     Product               @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([scdId, zoneSessionId, productId])
  @@index([businessId])
  @@index([scdId])
  @@index([productId])
  @@map("stock_count_lines")
}

// P3: Snapshot of ProductZoneAssignment rows at SCD creation time.
// Enables zone inheritance — new SCDs can read the previous SCD's snapshot
// to pre-populate zone count lines without re-assigning every product.
model ZoneAssignmentSnapshot {
  id          String   @id @default(cuid())
  scdId       String
  businessId  String
  productId   String
  zoneId      String
  createdAt   DateTime @default(now())

  scd       StockCountDay @relation(fields: [scdId], references: [id], onDelete: Cascade)
  business  Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  zone      StorageZone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([scdId, productId, zoneId])
  @@index([businessId])
  @@index([scdId])
  @@index([productId])
  @@index([zoneId])
  @@map("zone_assignment_snapshots")
}

// ── AI Provider Configuration ──
// Controls which vision/LLM provider is active. Only one row should have
// isActive=true at a time. The super-admin panel lets the founder switch
// providers (e.g., Gemini free now → Z.ai paid later) without a redeploy.
// The apiKey is stored plaintext — this is the user's own server, and they
// control access. For a hosted SaaS, encrypt this field.
model AiProvider {
  id        String   @id @default(cuid())
  provider  String   @unique  // "gemini" | "zai" | "openai"
  apiKey    String?           // provider API key (plaintext for MVP)
  baseUrl   String?           // optional override (e.g. for Z.ai internal endpoint)
  model     String?           // model name (e.g. "glm-ocr", "glm-4.6v-flash", "gemini-2.0-flash")
  isActive  Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("ai_providers")
}

// ═══════════════════════════════════════════════════════════════
// CCTV SHOP MODULE
// ═══════════════════════════════════════════════════════════════

// ── CCTV Categories ──
model CCTVCategory {
  id         String   @id @default(cuid())
  businessId String
  name       String               // "Cameras", "DVR/NVR", "Accessories", "Cables"
  slug       String               // "cameras", "dvr-nvr"
  icon       String   @default("Package")  // Lucide icon name
  color      String   @default("#7c3aed")  // Brand color
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business  Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products  CCTVProduct[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@map("cctv_categories")
}

// ── CCTV Products ──
model CCTVProduct {
  id           String   @id @default(cuid())
  businessId   String
  categoryId   String?
  name         String               // "DS-2CD2143G2" (model name)
  brand        String               // "Hikvision", "Dahua", "TP-Link"
  model        String?              // Full model: "Hikvision DS-2CD2143G2-I 4MP"
  sku          String?              // Internal SKU
  description  String?              // Short description
  hsnCode      String?              // VAT HSN code

  // Pricing
  costPrice    Float   @default(0)
  sellPrice    Float   @default(0)
  mrp          Float?              // Maximum Retail Price
  vatRate      Float   @default(0)  // VAT percentage

  // Stock
  stock        Int     @default(0)  // Total stock (non-serial items)
  unit         String   @default("piece")  // piece, box, pair, set, roll, meter
  minStock     Int     @default(0)  // Low stock alert
  maxStock     Int     @default(0)  // Overstock warning

  // Serial tracking
  serialTracked  Boolean  @default(false)  // Does this product track individual serials?
  warrantyMonths Int     @default(0)       // Warranty period in months

  // Media
  imageUrl     String?

  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business  Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category  CCTVCategory?       @relation(fields: [categoryId], references: [id])
  serialItems CCTVSerialItem[]
  kitComponents CCTVKitComponent[]
  saleItems    CCTVSaleItem[]

  @@index([businessId])
  @@index([categoryId])
  @@index([brand])
  @@index([name])
  @@index([serialTracked])
  @@map("cctv_products")
}

// ── CCTV Serial Items (1A Core: Serialized Asset Tracking) ──
// Each individually tracked unit — the heart of the CCTV inventory system.
// For high-value electronics, every unit is tracked by serial/IMEI, not bulk count.
// Stock count is DERIVED by counting units with status IN_STOCK (no aggregate field).
model CCTVSerialItem {
  id             String   @id @default(cuid())
  businessId     String
  productId      String

  // ── Identification ──
  serialNumber   String               // Unique serial number (for cameras, NVRs, etc.)
  imei           String?              // IMEI number (for mobile phones — 15 digits)
  // At least one of serialNumber or imei must be provided
  // IMEI is validated for uniqueness globally across the business

  // ── Status Lifecycle ──
  status         String   @default("IN_STOCK")
  // Valid values:
  //   "IN_STOCK"         — available for sale
  //   "IN_TRANSIT"        — moving between branches (Phase 1D)
  //   "SOLD"              — sold to customer
  //   "INSTALLED"         — installed at a CCTV project site
  //   "IN_REPAIR"         — at workshop for repair
  //   "RETURNED"          — returned by customer
  //   "WARRANTY_ACTIVE"   — under active warranty (post-repair or post-sale)
  //   "WARRANTY_EXPIRED"  — warranty period ended
  //   "DEFECTIVE"         — confirmed DOA or unrepairable
  //   "DISPOSED"          — written off / scrapped
  //   "CONSUMED"          — used as spare part in a repair job (Phase 2B)

  // ── Physical Condition ──
  grade          String?              // "A" (new/sealed), "B" (open box), "C" (refurbished), "D" (used)
  conditionNotes String?              // Pre-existing scratches, dents, screen cracks at intake

  // ── Pricing (may differ from product catalog default) ──
  costPrice      Float?
  sellPrice      Float?

  // ── Procurement Reference ──
  purchaseId     String?              // Links to the Purchase order this unit came from
  supplierId     String?              // Quick-lookup: which supplier supplied this unit
  purchaseDate   DateTime?            // Date of purchase (denormalized for quick display)

  // ── Warranty ──
  warrantyMonths Int      @default(0) // Warranty duration in months (from product or override)
  warrantyStart  DateTime?            // Warranty start date (typically set on sale date)
  warrantyEnd    DateTime?            // Calculated: warrantyStart + warrantyMonths

  // ── Customer Link (set when SOLD or INSTALLED) ──
  customerId     String?
  customerName   String?              // Denormalized for quick display
  customerPhone  String?

  // ── Sale / Job / Project References ──
  saleId         String?              // Reference to Sale when sold
  jobCardId      String?              // Reference to future JobCard model (Phase 2)
  projectId      String?              // Reference to future CCTVProject model (Phase 4)

  // ── Location Tracking ──
  branchId       String?              // Current branch (Phase 1D: multi-branch)
  currentLocation String?             // Free-text: "Showroom Shelf A3", "Warehouse Rack 2"

  // ── Metadata ──
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product       CCTVProduct           @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch        CCTVBranch?           @relation(fields: [branchId], references: [id])
  history       CCTVSerialItemHistory[]
  transferItems CCTVTransferItem[]
  jobCards      CCTVJobCard[]
  jobCardParts  CCTVJobCardPart[]
  saleItems     CCTVSaleItem[]
  warrantyClaims CCTVWarrantyClaim[]

  @@unique([businessId, serialNumber])
  @@index([businessId])
  @@index([productId])
  @@index([status])
  @@index([imei])
  @@index([customerId])
  @@index([saleId])
  @@index([warrantyEnd])
  @@index([purchaseId])
  @@index([branchId])
  @@map("cctv_serial_items")
}

// ── CCTV Serial Item History (1A: Append-Only Audit Log) ──
// Every status change on a SerialUnit is recorded here.
// This is the single source of truth for the unit's lifecycle.
// NEVER update or delete rows — always INSERT new entries.
model CCTVSerialItemHistory {
  id             String   @id @default(cuid())
  businessId     String
  serialItemId   String

  // What changed
  fromStatus     String?              // Previous status (null for creation event)
  toStatus       String               // New status after this event
  event          String               // What happened:
                                        //   "STOCKED"    — unit received into inventory
                                        //   "STATUS_CHANGED" — general status transition
                                        //   "SOLD"       — sold to customer
                                        //   "INSTALLED"  — installed at project site
                                        //   "REPAIR_START" — sent for repair
                                        //   "REPAIR_COMPLETE" — returned from repair
                                        //   "RETURNED"   — returned by customer
                                        //   "WARRANTY_CLAIM" — warranty service initiated
                                        //   "DISPOSED"   — written off
                                        //   "TRANSFERRED" — moved between branches
                                        //   "CONSUMED"   — used as spare part in repair (Phase 2B)

  // Who did it
  userId         String?              // BusinessUser who triggered this change

  // Context
  referenceId    String?              // ID of related entity (Sale, JobCard, Transfer, etc.)
  referenceType  String?              // "SALE", "JOB_CARD", "TRANSFER", "PROJECT", "PURCHASE"
  notes          String?              // Free-text reason: "Customer returned — screen cracked"

  createdAt      DateTime @default(now())

  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serialItem CCTVSerialItem  @relation(fields: [serialItemId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([serialItemId])
  @@index([toStatus])
  @@index([createdAt])
  @@map("cctv_serial_item_history")
}

// ── CCTV Kit Definition (1A: Product Bundles) ──
// A Kit is a virtual bundle — e.g., "4-Camera CCTV Package" that includes
// 4× Camera + 1× NVR + 1× HDD + 4× Cable + 1× Power Supply.
// Kits do NOT hold physical stock — they reference component products.
// When a kit is sold, the system validates all component SerialUnits are available.
model CCTVKitDefinition {
  id           String   @id @default(cuid())
  businessId   String
  name         String                 // "4-Camera Home Security Kit"
  slug         String                 // "4-camera-home-security-kit"
  description  String?                // Short description of what's included

  // Pricing (overrides sum of component prices if set)
  kitPrice     Float?                 // Bundle price (null = sum of component sell prices)
  discountPercent Float  @default(0)  // % discount when bought as kit vs individually

  // Metadata
  imageUrl     String?                // Kit image
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business   Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  components CCTVKitComponent[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([isActive])
  @@map("cctv_kit_definitions")
}

// ── CCTV Kit Component (1A: Items Within a Bundle) ──
// Each row links a product (and optional quantity) to its parent Kit.
// When selling a kit, the system checks that for each component,
// there are enough IN_STOCK SerialUnits (if serial-tracked) or sufficient
// stock quantity (if not serial-tracked).
model CCTVKitComponent {
  id               String   @id @default(cuid())
  kitId            String
  businessId       String
  productId        String             // References CCTVProduct

  // How many of this product are needed in the kit
  quantity         Int      @default(1)

  // Optional: label shown in the kit breakdown
  // e.g., "Main Camera", "Optional Add-on Camera"
  componentLabel   String?

  // Is this component required? (for future optional add-on support)
  isRequired       Boolean  @default(true)

  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  kit     CCTVKitDefinition @relation(fields: [kitId], references: [id], onDelete: Cascade)
  product CCTVProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([kitId])
  @@index([businessId])
  @@index([productId])
  @@map("cctv_kit_components")
}

// ── CCTV Branch (1D: Multi-Branch Inventory) ──
// Electronics retailers often operate from multiple locations.
// A Branch represents a physical location: warehouse, showroom, service center.
// Serial items are assigned to a branch to track stock per location.
model CCTVBranch {
  id           String   @id @default(cuid())
  businessId   String

  name         String                 // "Dhaka Warehouse", "Chittagong Showroom"
  code         String                 // Short code: "DHK", "CTG", "SAV"
  address      String?                // Full address
  phone        String?                // Branch contact number
  isDefault    Boolean  @default(false)  // Main branch (auto-created on business setup)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serialItems    CCTVSerialItem[]  // Items currently at this branch
  transfersFrom  CCTVTransfer[]    @relation("TransferFrom")
  transfersTo    CCTVTransfer[]    @relation("TransferTo")

  @@unique([businessId, code])
  @@index([businessId])
  @@index([isActive])
  @@map("cctv_branches")
}

// ── CCTV Transfer (1D: Stock Movement Between Branches) ──
// When stock moves from one branch to another, a Transfer record is created.
// Status lifecycle: DRAFT → IN_TRANSIT → RECEIVED  (or CANCELLED)
model CCTVTransfer {
  id             String   @id @default(cuid())
  businessId     String
  transferCode   String                 // Auto-generated: "TRF-2025-001"

  status         String   @default("DRAFT")
  // "DRAFT"       — being prepared, items can be added/removed
  // "IN_TRANSIT"  — sent out, source items changed to IN_TRANSIT
  // "RECEIVED"    — destination confirmed receipt, items now IN_STOCK at dest
  // "CANCELLED"   — transfer cancelled, items returned to source as IN_STOCK

  fromBranchId   String                 // Source branch
  toBranchId     String                 // Destination branch

  notes          String?                // Reason for transfer
  createdById    String?                // BusinessUser who initiated
  receivedById   String?                // BusinessUser who confirmed receipt
  receivedAt     DateTime?              // When destination confirmed
  cancelledAt    DateTime?              // When cancelled

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fromBranch   CCTVBranch           @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch     CCTVBranch           @relation("TransferTo", fields: [toBranchId], references: [id])
  items        CCTVTransferItem[]

  @@unique([businessId, transferCode])
  @@index([businessId])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
  @@index([createdAt])
  @@map("cctv_transfers")
}

// ── CCTV Transfer Item (1D: Individual Items in a Transfer) ──
// Each serial item being moved in a transfer gets its own row.
model CCTVTransferItem {
  id             String   @id @default(cuid())
  transferId     String
  businessId     String
  serialItemId   String                 // The actual serial item being moved

  status         String   @default("IN_TRANSIT")
  // "IN_TRANSIT"  — item is in transit
  // "RECEIVED"    — confirmed received at destination
  // "RETURNED"    — transfer cancelled, item returned to source

  createdAt      DateTime @default(now())

  transfer   CCTVTransfer    @relation(fields: [transferId], references: [id], onDelete: Cascade)
  serialItem CCTVSerialItem  @relation(fields: [serialItemId], references: [id])

  @@unique([transferId, serialItemId])
  @@index([transferId])
  @@index([businessId])
  @@index([serialItemId])
  @@map("cctv_transfer_items")
}

// ── CCTV Job Card (2A: Central Repair Document) ──
// The JobCard is the central document for every repair/service job.
// Created from stock-in screen, customer purchase history, or manual entry.
// Full lifecycle: RECEIVED → DIAGNOSING → AWAITING_PARTS → IN_PROGRESS → TESTING → READY_FOR_DELIVERY → DELIVERED
// Special status: OUTSOURCED (sent to external vendor)
model CCTVJobCard {
  id             String   @id @default(cuid())
  businessId     String
  jobCode        String                 // Auto-generated: "JC-2025-001"

  // ── Status Lifecycle ──
  status         String   @default("RECEIVED")
  // "RECEIVED"           — device dropped off by customer
  // "DIAGNOSING"         — technician is diagnosing the fault
  // "AWAITING_PARTS"     — parts needed, not in stock (Phase 2B)
  // "IN_PROGRESS"        — repair work underway
  // "TESTING"            — repair done, being tested
  // "READY_FOR_DELIVERY" — tested, ready for customer pickup
  // "DELIVERED"          — returned to customer
  // "OUTSOURCED"         — sent to external vendor (Phase 2E)
  // "CANCELLED"          — job cancelled (customer declined, etc.)

  // ── Job Type ──
  jobType        String   @default("REPAIR")
  // "REPAIR"             — fixing a broken device
  // "INSTALLATION"       — installing at a site
  // "MAINTENANCE"        — routine maintenance/checkup
  // "DIAGNOSTIC"         — diagnosis only, no repair

  // ── Customer Information ──
  customerId     String?                // Link to future Customer model
  customerName   String                 // Denormalized: customer name
  customerPhone  String                 // Customer contact phone

  // ── Device Reference ──
  serialItemId   String?                // Link to the device's SerialItem (if applicable)
  productId      String?                // Quick reference to product (if no serial item)
  deviceName     String?                // "Hikvision DS-2CD2143G2" (denormalized)
  serialNumber   String?                // Device serial number (denormalized)
  imei           String?                // Device IMEI (denormalized)

  // ── Physical Condition at Intake ──
  conditionNotes String?                // Pre-existing: scratches, dents, screen cracks
  photoUrls      String?                // JSON array of photo URLs (documented condition)

  // ── Fault & Repair ──
  reportedFault  String                 // Customer's reported problem
  diagnosis      String?                // Technician's diagnosis after inspection
  repairNotes    String?                // What was done / what needs to be done
  estimatedCost  Float?                 // Estimated repair cost in BDT
  finalCost      Float?                 // Actual repair cost charged
  laborCharge    Float?                 // Separate labor charge

  // ── Assignment ──
  assignedToId   String?                // BusinessUser ID of assigned technician
  assignedToName String?                // Denormalized technician name

  // ── Timestamps ──
  receivedAt     DateTime @default(now())  // When device was received
  diagnosedAt    DateTime?               // When diagnosis was completed
  startedAt      DateTime?               // When repair work started
  testedAt       DateTime?               // When testing was completed
  readyAt        DateTime?               // When marked ready for delivery
  deliveredAt    DateTime?               // When returned to customer
  outsourcedAt   DateTime?               // When sent to external vendor

  // ── Delivery (Phase 2D) ──
  collectorName  String?                // Person who picked up
  collectorNid   String?                // NID of collector
  collectorPhone String?                // Phone of collector
  otpCode        String?                // 6-digit OTP (hardcoded 999999)
  otpGeneratedAt DateTime?              // When OTP was generated
  otpVerified    Boolean  @default(false)
  otpVerifiedAt  DateTime?              // When OTP was verified
  satisfactionRating Int?               // 1-5 customer satisfaction (Phase 2C)

  // ── Outsourcing (Phase 2E) ──
  vendorId       String?                // Link to CCTVOutsourcedVendor
  vendorName     String?                // External vendor name (denormalized)
  vendorPhone    String?                // Vendor contact (denormalized)
  vendorCost     Float?                 // Cost quoted by vendor
  expectedReturn DateTime?              // Expected return date from vendor

  // ── Priority ──
  priority       String   @default("NORMAL")
  // "LOW", "NORMAL", "HIGH", "URGENT"

  // ── Internal ──
  internalNotes  String?                // Notes not visible to customer
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serialItem  CCTVSerialItem?  @relation(fields: [serialItemId], references: [id])
  parts       CCTVJobCardPart[]
  commissionRecord CCTVCommissionRecord?
  outsourcedVendor CCTVOutsourcedVendor? @relation(fields: [vendorId], references: [id])

  @@unique([businessId, jobCode])
  @@index([businessId])
  @@index([status])
  @@index([jobType])
  @@index([customerId])
  @@index([serialItemId])
  @@index([assignedToId])
  @@index([customerPhone])
  @@index([receivedAt])
  @@index([priority])
  @@index([vendorId])
  @@map("cctv_job_cards")
}

// ── CCTV Job Card Part (2B: Spare Parts Integration) ──
// Junction table linking a consumed spare part (SerialItem) to a JobCard.
// When a technician logs a part, the serial item status changes to CONSUMED
// and its cost is added to the repair bill.
model CCTVJobCardPart {
  id            String   @id @default(cuid())
  businessId    String
  jobCardId     String
  serialItemId  String

  // Cost at time of consumption (snapshotted from SerialItem.costPrice)
  unitCost      Float?
  quantity      Int      @default(1)
  notes         String?

  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobCard    CCTVJobCard     @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  serialItem CCTVSerialItem  @relation(fields: [serialItemId], references: [id])

  @@unique([jobCardId, serialItemId])
  @@index([businessId])
  @@index([jobCardId])
  @@index([serialItemId])
  @@map("cctv_job_card_parts")
}

// ── CCTV Technician (2C: Technician Performance and Commissions) ──
// Links a BusinessUser to a technician profile for performance tracking.
model CCTVTechnician {
  id             String   @id @default(cuid())
  businessId     String
  userId         String?              // Optional link to BusinessUser
  displayName    String               // "Rahim", "Karim"
  phone          String?
  specialization String?              // "Camera expert", "NVR/DVR specialist"
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business       Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  commissionRecords CCTVCommissionRecord[]

  @@index([businessId])
  @@index([userId])
  @@map("cctv_technicians")
}

// ── CCTV Commission Rule (2C) ──
// Configurable per business. Determines how commission is calculated.
model CCTVCommissionRule {
  id             String   @id @default(cuid())
  businessId     String
  name           String               // "Camera repair - fixed", "Labor 15%"
  ruleType       String               // "FIXED_PER_TYPE" | "PERCENT_LABOR" | "PERCENT_PROFIT"
  jobType        String?              // "REPAIR", "INSTALLATION", etc. (for FIXED_PER_TYPE)
  fixedAmount    Float?               // BDT amount (for FIXED_PER_TYPE)
  percentRate    Float?               // 0-100 (for PERCENT_LABOR / PERCENT_PROFIT)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business       Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  commissionRecords CCTVCommissionRecord[]

  @@index([businessId])
  @@map("cctv_commission_rules")
}

// ── CCTV Commission Record (2C) ──
// Auto-calculated when a job card is delivered. Stores the snapshot for reporting.
model CCTVCommissionRecord {
  id               String   @id @default(cuid())
  businessId       String
  technicianId     String
  jobCardId        String
  ruleId           String?              // Which rule was applied (null if no rule matched)
  commissionAmount Float               // Calculated commission in BDT
  ruleType         String               // Snapshot of the rule type used
  jobType          String               // Snapshot of job card jobType
  laborCharge      Float?               // Snapshot of labor charge at calculation time
  partsCost        Float?               // Snapshot of total parts cost
  profitMargin     Float?               // finalCost - partsCost - laborCharge
  month            String               // "YYYY-MM" for monthly grouping
  createdAt        DateTime @default(now())

  business         Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  technician       CCTVTechnician        @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  rule             CCTVCommissionRule?   @relation(fields: [ruleId], references: [id])
  jobCard          CCTVJobCard           @relation(fields: [jobCardId], references: [id])

  @@unique([jobCardId])                // One commission record per job card
  @@index([businessId])
  @@index([technicianId])
  @@index([month])
  @@index([createdAt])
  @@map("cctv_commission_records")
}

// ── CCTV Outsourced Vendor (2E: Outsourced Repair Tracking) ──
// Reusable vendor directory for outsourced repairs.
// Vendors like Motalib Plaza specialists can be referenced from JobCards.
model CCTVOutsourcedVendor {
  id             String   @id @default(cuid())
  businessId     String
  name           String               // "Motalib Plaza Chip Repair"
  phone          String?
  address        String?              // Shop location / floor
  specialization String?              // "Motherboard repair", "Chip-level"
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  jobCards       CCTVJobCard[]

  @@index([businessId])
  @@map("cctv_outsourced_vendors")
}

// ── CCTV Sale (3A: Payment Integration) ──
// Sale header. Payment status auto-calculated from linked CCTVPayment rows.
// Supports split payment across multiple methods.
model CCTVSale {
  id              String   @id @default(cuid())
  businessId      String
  saleCode        String                  // "SAL-2025-001"
  status          String   @default("PENDING")  // PENDING / PARTIALLY_PAID / PAID

  // Customer info (denormalised for fast queries)
  customerId      String?                 // link to Customer model if exists
  customerName    String   @default("Walk-in Customer")
  customerPhone   String?

  // Totals
  subtotal        Float    @default(0)    // sum of sale items before discount
  discountAmount  Float    @default(0)    // flat discount in BDT
  totalDue        Float                  // final amount customer owes

  // Metadata
  notes           String?
  isActive        Boolean  @default(true)
  completedAt     DateTime?               // set when status becomes PAID
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payments        CCTVPayment[]
  emiPlan         CCTVEmiPlan?
  items           CCTVSaleItem[]
  project         CCTVProject?    // If this sale is linked to a project (Phase 4A)
  mushakInvoices  CCTVMushakInvoice[]  // Phase 5B

  @@unique([businessId, saleCode])
  @@index([businessId])
  @@index([status])
  @@map("cctv_sales")
}

// ── CCTV Sale Item (3A: Payment Integration) ──
// Individual product line in a sale. For serial-tracked products, optionally
// links to a specific serial item (which gets marked SOLD).
model CCTVSaleItem {
  id              String   @id @default(cuid())
  businessId      String
  saleId          String
  productId       String
  serialItemId    String?                 // for serial-tracked products
  productName     String                  // denormalised product name
  productBrand    String?                 // denormalised brand
  quantity        Int
  unitPrice       Float                   // sell price at time of sale
  totalPrice      Float                   // unitPrice * quantity
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sale            CCTVSale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product         CCTVProduct     @relation(fields: [productId], references: [id])
  serialItem      CCTVSerialItem? @relation(fields: [serialItemId], references: [id])

  @@index([businessId])
  @@index([saleId])
  @@map("cctv_sale_items")
}

// ── CCTV Payment (3A: Payment Integration) ──
// Individual payment row. A single sale can have multiple payments (split payment).
// Method types: CASH, CARD, BKASH, NAGAD, ROCKET
model CCTVPayment {
  id              String   @id @default(cuid())
  businessId      String
  saleId          String
  method          String                  // CASH / CARD / BKASH / NAGAD / ROCKET
  amount          Float                   // amount paid in BDT
  referenceNumber String?                 // card terminal ref OR MFS transaction ID
  receivedBy      String?                 // staff member who received payment
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sale            CCTVSale        @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([saleId])
  @@map("cctv_payments")
}

// ── CCTV EMI Plan (3B: EMI Sales Management) ──
// Equated Monthly Installment plan for high-value items.
// Interest calculated at plan creation using reducing balance or flat rate method.
// Installments are generated upfront as individual rows for tracking.
model CCTVEmiPlan {
  id              String   @id @default(cuid())
  businessId      String
  saleId          String?                 // optional link to the CCTVSale that created this EMI (one-to-one)

  // Customer info (denormalised)
  customerName    String
  customerPhone   String

  // Product info (denormalised)
  productName     String
  productBrand    String?

  // Financial terms
  totalAmount     Float                   // total price of the item (principal)
  downPayment     Float    @default(0)    // upfront payment
  financedAmount  Float                   // totalAmount - downPayment = amount to be paid in installments
  interestRate    Float    @default(0)    // annual interest rate in % (e.g., 12.5)
  interestType    String   @default("REDUCING") // REDUCING (reducing balance) or FLAT
  totalInterest   Float    @default(0)    // total interest charged over the life of the plan
  grandTotal      Float                   // financedAmount + totalInterest (total customer pays via installments)
  months          Int                     // number of installments (e.g., 12)
  monthlyPayment  Float                   // EMI amount per month

  // Schedule
  startDate       DateTime                // first installment due date
  graceDays       Int      @default(3)    // days after due date before marked overdue

  // Summary (computed on each payment)
  paidInstallments Int     @default(0)
  paidAmount       Float   @default(0)    // total amount collected so far
  remainingAmount  Float                   // grandTotal - paidAmount

  // Status: ACTIVE, COMPLETED, DEFAULTED, CANCELLED
  status          String   @default("ACTIVE")
  completedAt     DateTime?
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sale            CCTVSale?             @relation(fields: [saleId], references: [id])
  installments    CCTVEmiInstallment[]

  @@index([businessId])
  @@index([status])
  @@index([customerPhone])
  @@unique([saleId])
  @@map("cctv_emi_plans")
}

// ── CCTV EMI Installment (3B: EMI Sales Management) ──
// Individual installment row. Generated at plan creation.
// Status: PENDING, PAID, OVERDUE, WAIVED
model CCTVEmiInstallment {
  id              String   @id @default(cuid())
  businessId      String
  emiPlanId       String

  installmentNo   Int                     // 1-based (1st month, 2nd month, etc.)
  dueDate         DateTime                // when this installment is due
  dueAmount       Float                   // amount expected
  paidAmount      Float    @default(0)    // amount actually paid
  paidAt          DateTime?               // when payment was recorded
  receivedBy      String?                 // staff member
  status          String   @default("PENDING") // PENDING, PAID, OVERDUE, WAIVED
  waiverAmount    Float    @default(0)    // if waived (partial or full)
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  emiPlan         CCTVEmiPlan  @relation(fields: [emiPlanId], references: [id], onDelete: Cascade)

  @@unique([emiPlanId, installmentNo])
  @@index([businessId])
  @@index([emiPlanId])
  @@index([status])
  @@index([dueDate])
  @@map("cctv_emi_installments")
}

// ── CCTV Loyalty Config (3C: Customer Loyalty and CRM) ──
// Per-business loyalty program settings. One config per business.
// Controls earn rates, redemption rates, and tier thresholds.
model CCTVLoyaltyConfig {
  id              String   @id @default(cuid())
  businessId      String   @unique

  // Earn rules: customer earns 1 point for every earnRateAmount BDT spent
  earnRatePoints  Int     @default(1)    // points earned per threshold
  earnRateAmount  Float   @default(100)  // BDT spent per earn event

  // Redeem rules: redeemRateValue BDT discount per redeemPointsRequired points
  redeemPointsRequired Int   @default(100) // points needed
  redeemRateValue     Float @default(10)  // BDT value received

  // Tier thresholds based on totalSpent (cumulative)
  tierBronze      Float   @default(0)       // default tier
  tierSilver      Float   @default(50000)   // >= 50K BDT
  tierGold        Float   @default(200000)  // >= 200K BDT
  tierPlatinum    Float   @default(500000)  // >= 500K BDT

  isActive        Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  offers          CCTVLoyaltyOffer[]

  @@index([businessId])
  @@map("cctv_loyalty_configs")
}

// ── CCTV Loyalty Transaction (3C: Customer Loyalty and CRM) ──
// Append-only ledger of all points movements for a customer.
// Types: EARN (from purchase), REDEEM (spent at checkout), BONUS (from offer), ADJUST (manual)
model CCTVLoyaltyTransaction {
  id              String   @id @default(cuid())
  businessId      String
  customerId      String

  type            String   // EARN / REDEEM / BONUS / ADJUST
  points          Int      // positive = earn/bonus, negative = redeem
  balanceAfter    Int      // running balance snapshot after this transaction

  saleId          String?  // link to CCTVSale when earned from purchase
  offerId         String?  // link to CCTVLoyaltyOffer when from a promotion
  description     String?
  createdById     String?
  createdAt       DateTime @default(now())

  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([customerId])
  @@index([type])
  @@map("cctv_loyalty_transactions")
}

// ── CCTV Loyalty Offer (3C: Customer Loyalty and CRM) ──
// Time-limited promotional offers configured by shop owner.
// DOUBLE_POINTS: 2x points on all purchases during the period.
// BONUS_POINTS: flat bonus points on next purchase.
model CCTVLoyaltyOffer {
  id              String   @id @default(cuid())
  businessId      String
  configId        String

  name            String
  offerType       String   // DOUBLE_POINTS / BONUS_POINTS
  multiplier      Float   @default(2)    // 2x for DOUBLE_POINTS
  bonusPoints     Int?                  // flat bonus for BONUS_POINTS
  startDate       DateTime
  endDate         DateTime
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  config          CCTVLoyaltyConfig  @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([configId])
  @@map("cctv_loyalty_offers")
}

// ── CCTV Warranty Claim (3D: Warranty Tracking and Alerts) ──
// Records warranty claims when customers bring in items for warranty repair/service.
// A claim tracks the issue, approval status, and any linked repair job card.
model CCTVWarrantyClaim {
  id              String   @id @default(cuid())
  businessId      String
  serialItemId    String                   // which serial item is claimed

  // Customer info (denormalized)
  customerName    String
  customerPhone   String?

  // Claim details
  issueDescription String                  // what the customer reports
  status          String   @default("PENDING")  // PENDING / APPROVED / REJECTED / IN_PROGRESS / COMPLETED / CANCELLED
  resolutionNotes String?                  // what was done to resolve
  approvedAt      DateTime?                // when claim was approved
  completedAt     DateTime?                // when claim was completed/rejected
  approvedById    String?                  // staff who approved

  // Optional link to a repair job card
  jobCardId       String?                  // if a job card is created for the warranty repair

  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serialItem      CCTVSerialItem  @relation(fields: [serialItemId], references: [id])

  @@index([businessId])
  @@index([serialItemId])
  @@index([status])
  @@index([customerPhone])
  @@map("cctv_warranty_claims")
}

// ── CCTV Project (4A: Project and Site Survey Management) ──
// Represents a CCTV installation project linked to a customer and optionally a sale.
// Tracks the full lifecycle: Planning → Survey → Procurement → Installation → Testing → Handover → Completed.
model CCTVProject {
  id              String   @id @default(cuid())
  businessId      String

  // Project identification
  projectName     String                   // "City Mall Surveillance System"
  projectCode     String                   // Auto-generated: "PRJ-001"

  // Client information (denormalized for quick display)
  clientId        String?                  // Link to Customer model
  clientName      String                   // Client/company name
  clientPhone     String?
  clientEmail     String?
  clientAddress   String?

  // Project scope & status
  status          String   @default("PLANNING")  // PLANNING / SURVEY / PROCUREMENT / INSTALLATION / TESTING / HANDOVER / COMPLETED / CANCELLED
  projectType     String   @default("INSTALLATION")  // INSTALLATION / MAINTENANCE / UPGRADE / REPAIR
  totalItems      Int      @default(0)     // Total equipment items planned
  completedItems  Int      @default(0)     // Items installed so far
  projectValue    Float    @default(0)     // Total project value in BDT

  // Timeline
  startDate       DateTime?                // When work starts
  deadline        DateTime?                // Expected completion
  completedAt     DateTime?                // Actual completion

  // Site details
  siteAddress     String?                  // Where installation happens
  siteContact     String?                  // On-site contact person
  siteContactPhone String?                 // On-site contact phone

  // Optional link to a sale (if project was sold through POS)
  saleId          String?                  @unique

  // Notes
  notes           String?                  // Visible to client
  internalNotes   String?                  // Internal team notes

  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sale            CCTVSale?       @relation(fields: [saleId], references: [id])
  surveys         CCTVSiteSurvey[]
  installationTasks CCTVInstallationTask[]

  @@unique([businessId, projectCode])
  @@index([businessId])
  @@index([status])
  @@index([clientId])
  @@index([deadline])
  @@map("cctv_projects")
}

// ── CCTV Site Survey (4A: Project and Site Survey Management) ──
// A survey captures the pre-installation site assessment: floor plan,
// camera positions, cable routes, and blind spot analysis.
model CCTVSiteSurvey {
  id              String   @id @default(cuid())
  businessId      String
  projectId       String

  // Floor plan (base64 data URI for the image)
  floorPlanData   String?                  // base64-encoded image data URI
  floorPlanName   String?                  // Original filename

  // Survey details
  surveyDate      DateTime @default(now())
  surveyorName    String?                  // Who conducted the survey

  // Notes
  notes           String?                  // Blind spot analysis, observations

  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  project         CCTVProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cameraPositions CCTVCameraPosition[]
  cableRoutes     CCTVCableRoute[]

  @@index([businessId])
  @@index([projectId])
  @@map("cctv_site_surveys")
}

// ── CCTV Camera Position (4A: Site Survey — Camera Placement) ──
// Represents a camera marker pin-dropped on the floor plan.
// Coordinates are 0-100 percentage values relative to the floor plan image.
model CCTVCameraPosition {
  id              String   @id @default(cuid())
  businessId      String
  surveyId        String

  // Position on floor plan (percentage: 0-100)
  posX            Float                    // X position (%) left to right
  posY            Float                    // Y position (%) top to bottom

  // Camera details
  label           String                   // e.g., "Camera 1 — Main Entrance"
  cameraType      String   @default("Bullet")  // Bullet / Dome / PTZ / Box / Turret
  resolution      String?                  // e.g., "2MP", "4MP", "8MP"
  notes           String?
  sortOrder       Int      @default(0)

  createdAt       DateTime @default(now())

  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  survey          CCTVSiteSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([surveyId])
  @@map("cctv_camera_positions")
}

// ── CCTV Cable Route (4A: Site Survey — Cable Route Annotation) ──
// A cable route drawn on the floor plan as a polyline of points.
// Points stored as JSON string: [{"x":10,"y":20},{"x":30,"y":40},...]
model CCTVCableRoute {
  id              String   @id @default(cuid())
  businessId      String
  surveyId        String

  // Route details
  label           String                   // e.g., "Cable Run 1 — Corridor to NVR Room"
  points          String                   // JSON: [{"x":10,"y":20},{"x":30,"y":40},...]
  cableType       String   @default("Cat6")  // Cat5e / Cat6 / Coaxial / Fiber
  cableLength     Float?                  // Estimated length in meters
  notes           String?
  sortOrder       Int      @default(0)

  createdAt       DateTime @default(now())

  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  survey          CCTVSiteSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([surveyId])
  @@map("cctv_cable_routes")
}

// ── 4C: Annual Maintenance Contracts ──

model CCTVAmcContract {
  id              String   @id @default(cuid())
  businessId      String
  contractCode    String                    // e.g., AMC-001
  clientId        String?                   // linked customer
  clientName      String
  clientPhone     String?
  clientEmail     String?
  clientAddress   String?

  // Contract terms
  coverageType    String   @default("Standard")  // Basic / Standard / Premium
  startDate       DateTime
  endDate         DateTime
  totalAmount     Float                          // annual contract value (BDT)
  paymentFrequency String  @default("MONTHLY")   // MONTHLY / QUARTERLY / ANNUAL
  paymentAmount   Float                          // per-payment amount
  visitsIncluded  Int      @default(1)           // site visits included per month
  slaTerms        String?                        // service level agreement notes
  responseHours   Int      @default(48)          // max response time in hours

  // Status & value tracking
  status          String   @default("ACTIVE")    // ACTIVE / EXPIRING_SOON / EXPIRED / CANCELLED
  totalVisitsUsed Int      @default(0)
  totalRevenue    Float    @default(0)           // total payments received
  notes           String?
  internalNotes   String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  visits          CCTVAmcVisit[]

  @@index([businessId])
  @@index([clientId])
  @@index([status])
  @@map("cctv_amc_contracts")
}

model CCTVAmcVisit {
  id              String   @id @default(cuid())
  businessId      String
  contractId      String

  // Visit details
  visitDate       DateTime
  technicianName  String?
  technicianId    String?
  visitType       String   @default("SCHEDULED")  // SCHEDULED / EMERGENCY / RENEWAL
  workPerformed   String?                          // summary of work done
  partsReplaced   String?                          // JSON: [{partName, serialNumber, cost}]
  partsCost       Float    @default(0)
  findings        String?                          // issues found during visit
  customerSignOff Boolean  @default(false)
  visitNotes      String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  contract        CCTVAmcContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([contractId])
  @@map("cctv_amc_visits")
}

// ── 4D: Installation Task Scheduling ──

model CCTVInstallationTask {
  id              String   @id @default(cuid())
  businessId      String
  projectId       String

  // Task identification
  taskTitle       String                    // "Install cameras on 2nd floor"
  scheduledDate   DateTime                  // When the task is scheduled
  completedDate   DateTime?                 // When actually completed

  // Assignment
  assignedToId    String?                   // Link to CCTVTechnician
  assignedToName  String?                   // Denormalized for quick display

  // Location
  location        String?                   // e.g., "2nd Floor, East Wing"
  siteAddress     String?                   // Denormalized from project

  // Status
  status          String   @default("PENDING")  // PENDING / IN_PROGRESS / COMPLETED / OVERDUE / CANCELLED
  priority        String   @default("NORMAL")   // LOW / NORMAL / HIGH / URGENT

  // Progress tracking
  totalChecklist  Int      @default(0)
  completedChecklist Int   @default(0)

  // Notes
  notes           String?
  internalNotes   String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  project         CCTVProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checklists      CCTVTaskChecklist[]

  @@index([businessId])
  @@index([projectId])
  @@index([status])
  @@index([scheduledDate])
  @@index([assignedToId])
  @@map("cctv_installation_tasks")
}

model CCTVTaskChecklist {
  id              String   @id @default(cuid())
  businessId      String
  taskId          String

  // Checklist item
  itemText        String                    // "Mount 4 bullet cameras"
  isCompleted     Boolean  @default(false)
  sortOrder       Int      @default(0)

  // Optional details
  notes           String?
  completedAt     DateTime?

  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  business        Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  task            CCTVInstallationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([taskId])
  @@map("cctv_task_checklists")
}

// ── 5A: NBR Compliance – BIN & Tax Configuration ──
// One config per business; created on first access.
model CCTVNbrConfig {
  id                   String   @id @default(cuid())
  businessId           String   @unique

  // Business Identification Number (issued by NBR, Bangladesh)
  bin                  String?
  taxRegistrationStatus String  @default("UNREGISTERED") // UNREGISTERED / REGISTERED / EXEMPT
  applicableVatRate    Float    @default(15.0)            // default 15% VAT

  // Mushak invoice auto-numbering
  mushakInvoicePrefix  String   @default("MUSHAK")       // e.g. "MUSHAK" → MUSHAK-0001
  mushakInvoiceSeq     Int      @default(0)              // last used sequence number

  // Business legal details (for Mushak 6.3)
  legalName            String?  // registered business name (may differ from shop name)
  legalAddress         String?  // registered address
  tradeLicenseNo       String?  // trade license number

  // Configuration flags
  isVatEnabled         Boolean  @default(false)          // master switch for VAT calculation
  autoMushakInvoice    Boolean  @default(false)          // auto-generate Mushak 6.3 on sale

  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  business             Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  hsCodeMappings       CCTVHsCodeMapping[]

  @@index([businessId])
  @@map("cctv_nbr_configs")
}

// ── 5A: HS Code Mappings per Product Category ──
// Pre-populated with BD electronics defaults; editable per business.
model CCTVHsCodeMapping {
  id                   String   @id @default(cuid())
  businessId           String
  configId             String

  category             String                        // e.g. "Cameras", "NVRs", "Cables"
  hsCode               String                        // e.g. "8525.89", "8521.90"
  description          String?                       // e.g. "Television cameras, digital cameras"
  vatRate              Float    @default(15.0)       // per-category override (null = use config default)
  isDefault            Boolean  @default(false)       // true = system-seeded default
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  config               CCTVNbrConfig        @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, category])
  @@index([businessId])
  @@index([configId])
  @@map("cctv_hs_code_mappings")
}

// ── 5B: Mushak 6.3 Tax Invoice ──
// Immutable snapshot of a tax invoice for audit trail.
model CCTVMushakInvoice {
  id              String   @id @default(cuid())
  businessId      String
  saleId          String                       // source sale

  // Sequential invoice number (auto-generated)
  invoiceNumber   String                       // e.g. "MUSHAK-0001"
  issueDate       DateTime @default(now())

  // Seller details (from NBR config / Business)
  sellerName      String
  sellerAddress   String?
  sellerBin       String?

  // Buyer details (entered at invoice generation)
  buyerName       String
  buyerAddress    String?
  buyerBin        String?

  // Totals
  subtotal        Float    @default(0)          // sum of line totals
  totalVat        Float    @default(0)          // sum of line VAT
  grandTotal      Float    @default(0)          // subtotal + totalVat
  discountAmount  Float    @default(0)          // if any discount applied

  // Amount in words (English)
  amountInWords   String?

  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sale            CCTVSale        @relation(fields: [saleId], references: [id])
  lineItems       CCTVMushakLineItem[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([saleId])
  @@index([issueDate])
  @@map("cctv_mushak_invoices")
}

// ── 5B: Mushak 6.3 Line Item ──
// One row per product in the invoice (denormalized snapshot).
model CCTVMushakLineItem {
  id              String   @id @default(cuid())
  businessId      String
  invoiceId       String

  slNo            Int                          // serial number in invoice (1, 2, 3...)
  productName     String                       // product description
  hsCode          String?                      // HS code (looked up from HS mappings)
  quantity        Int
  unitPrice       Float                        // price per unit (excl VAT)
  totalPrice      Float                        // quantity * unitPrice
  vatRate         Float                        // VAT % for this line
  vatAmount       Float                        // VAT for this line

  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  invoice         CCTVMushakInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([invoiceId])
  @@map("cctv_mushak_line_items")
}

// ── 5D: Monthly VAT Return (Mushak 9.1) ──
// Stores monthly VAT return data; auto-calculated from Mushak 6.1/6.3 data.
model CCTVVatReturn {
  id              String   @id @default(cuid())
  businessId      String

  // Tax period
  taxYear         Int                            // e.g. 2025
  taxMonth        Int                            // 1-12

  // Section A: Opening balance of input tax credit from previous month
  openingCredit   Float    @default(0)           // carried forward input tax credit

  // Section B: Tax credit on local purchase (from Mushak 6.1)
  localPurchaseCredit  Float   @default(0)       // VAT paid on local purchases
  localPurchaseValue   Float   @default(0)       // total purchase value
  localPurchaseCount   Int     @default(0)       // number of purchase invoices

  // Section C: Tax credit on import
  importCredit   Float    @default(0)            // VAT/duty paid on imports
  importValue    Float    @default(0)            // total import value
  importCount    Int      @default(0)            // number of import documents

  // Section D: Total input tax credit (A + B + C)
  totalInputCredit  Float   @default(0)         // sum of A + B + C

  // Section E: Output tax (VAT collected on sales, from Mushak 6.3)
  outputTax      Float    @default(0)            // VAT collected on supply
  salesValue     Float    @default(0)            // total sales value
  salesCount     Int      @default(0)            // number of sales invoices

  // Section F: Net VAT
  netVatPayable  Float    @default(0)            // E - D (positive = payable to NBR, negative = refundable)

  // Section G: Adjustments
  adjustmentAmount  Float   @default(0)          // manual adjustment (+/-)
  adjustmentNote    String?                     // reason for adjustment
  adjustedNetVat    Float   @default(0)          // netVatPayable + adjustmentAmount

  // Status
  status         String   @default("DRAFT")      // DRAFT / SUBMITTED / APPROVED

  // Declaration
  declaredBy     String?                       // name of declarant
  declaredAt     DateTime?                     // when declared
  submittedAt    DateTime?                     // when submitted to NBR

  // Amount in words
  amountInWords  String?

  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, taxYear, taxMonth])
  @@index([businessId])
  @@index([taxYear, taxMonth])
  @@map("cctv_vat_returns")
}
